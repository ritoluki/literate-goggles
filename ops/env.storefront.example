# Design example. Copy to app-local ignored env only after P0 maps actual code names.
# NEVER place a secret in NEXT_PUBLIC_* or commit a filled .env.
NODE_ENV=development
APP_MODE=demo
SITE_ORIGIN=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:9000
BFF_SERVICE_SECRET=
CSRF_SECRET=
SESSION_COOKIE_NAME=bg_session
SESSION_COOKIE_SECURE=false
# Server calls only; this is not sufficient authorization by itself.
MEDUSA_PUBLISHABLE_KEY=
CHECKOUT_ENABLED=true
CHECKOUT_LIVE_APPROVED=false
# Demo local may use test data. Public staging must be access-gated and test-only.
STAGING_ACCESS_GATED=false
LOG_LEVEL=info
