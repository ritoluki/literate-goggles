# Example variable names for agent to implement and validate.
# Verify Medusa official config field mapping for installed version.
NODE_ENV=development
APP_MODE=demo
PORT=9000
DATABASE_URL=
REDIS_URL=
# Medusa API server/worker runtime mapping must be verified; not merely an env name.
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3000
JWT_SECRET=
COOKIE_SECRET=
BFF_SERVICE_SECRET=
REVIEW_SIGNING_SECRET=
CATALOG_INVALIDATION_SECRET=
STOREFRONT_INTERNAL_URL=http://localhost:3000
SESSION_TOKEN_HASH_SECRET=
CHECKOUT_ENABLED=true
CHECKOUT_LIVE_APPROVED=false
# Jev off by default. Account approval + live evidence needed to enable.
AI_PROVIDER=rules
AI_PROVIDER_APPROVED=false
OPENCODE_API_KEY=
JEV_MODEL=jev-1.13-free
AI_ALLOW_PAID_FALLBACK=false
AI_TIMEOUT_MS=1500
AI_MAX_REQUEST_BYTES=16384
AI_MAX_RESPONSE_BYTES=65536
AI_MAX_CANDIDATES=12
AI_GLOBAL_CONCURRENCY=4
AI_SESSION_PER_MINUTE=8
AI_SESSION_PER_DAY=30
AI_GLOBAL_PER_DAY=1000
AI_MAX_CLARIFICATIONS=2
# local-sink first; no accidental external messages from development.
EMAIL_PROVIDER=local-sink
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
STAGING_EMAIL_ALLOWLIST=
# Optional for local; configure S3 provider mapping in Medusa when enabled.
FILES_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
LOG_LEVEL=info
